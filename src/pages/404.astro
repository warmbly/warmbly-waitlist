---
import Layout from '../layouts/Layout.astro';
import WaitlistHero from '../components/WaitlistHero.astro';

/**
 * Every unmatched URL renders the waitlist instead of an error page — there is
 * nothing else to browse yet, so a dead end would only lose a signup. Kept out
 * of the index (canonical + noindex) so it never competes with `/`.
 */
const title = "Warmbly | Open Source AI Email Warmup & Outreach"
const description = "Warmbly is an open source, AI-powered email warmup and outreach platform that builds your sender reputation and keeps you out of spam. Join the waitlist for early access."
---

<Layout {title} {description} canonical="/" noindex>
  <WaitlistHero />
</Layout>
